<Window x:Class="SwitchCfwWizard.SdReset.SdResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SwitchCfwWizard.Localization"
        Title="{loc:Loc SdReset.Title}"
        Icon="/ico.ico"
        Width="880"
        Height="800"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Meiryo"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 标题 + 四步 ══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc SdReset.Title}" Style="{StaticResource TitleText}" FontSize="21" />
            <UniformGrid Columns="4" Margin="0,12,0,0">
                <TextBlock x:Name="Step1" Text="{loc:Loc SdReset.Step.Settings}" Style="{StaticResource StepText}" />
                <TextBlock x:Name="Step2" Text="{loc:Loc SdReset.Step.Confirm}" Style="{StaticResource StepText}" />
                <TextBlock x:Name="Step3" Text="{loc:Loc SdReset.Step.Write}" Style="{StaticResource StepText}" />
                <TextBlock x:Name="Step4" Text="{loc:Loc SdReset.Step.Done}" Style="{StaticResource StepText}" />
            </UniformGrid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>

                <!-- ══ ① 分区设置 ══ -->
                <StackPanel x:Name="SettingsPanel">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc SdReset.Device.Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="RefreshButton" Grid.Column="1"
                                        Content="{loc:Loc SdReset.Device.Refresh}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,4"
                                        Click="Refresh_Click" />
                            </Grid>
                            <!-- 用 DisplayMemberPath 而不是 ItemTemplate：两者都能决定**下拉列表**怎么画，
                                 但「收起后那一条」只认 DisplayMemberPath（ItemTemplate 只管列表项）。
                                 原先只写了 ItemTemplate，配合「不自动选中」，收起时就是一个空框 ——
                                 看起来像「没检测到卡」，其实卡就在列表里。 -->
                            <ComboBox x:Name="DevicePicker" MinHeight="38" Margin="0,8,0,0"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="Device_Changed" />
                            <TextBlock x:Name="DeviceDetails" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <RadioButton x:Name="WithEmu" GroupName="Mode" IsChecked="True"
                                         Content="{loc:Loc SdReset.Mode.Rebuild}"
                                         Checked="Options_Changed" />
                            <TextBlock Text="{loc:Loc SdReset.Mode.Rebuild.Hint}" Style="{StaticResource HintText}"
                                       Margin="20,4,0,12" />
                            <RadioButton x:Name="OnlyFormat" GroupName="Mode"
                                         Content="{loc:Loc SdReset.Mode.FormatOnly}"
                                         Checked="Options_Changed" />
                            <TextBlock Text="{loc:Loc SdReset.Mode.FormatOnly.Hint}" Style="{StaticResource HintText}"
                                       Margin="20,4,0,12" />

                            <!-- 下面四个是**同级**的独立选项（用户 2026-11-21）：
                                 各自是一种手术，不再挂在某个选项底下。互斥由 GroupName="Mode" 本身保证
                                 —— 单选按钮天然只有一个能选中，不需要代码再去取消别人。
                                 前三个不动分区表（布局条隐藏）；最后一个要重做（布局条照常出现，可以拖容量）。 -->
                            <RadioButton x:Name="ModeFormatMain" GroupName="Mode"
                                         Content="{loc:Loc SdReset.Mode.FormatMain}"
                                         Checked="Options_Changed" />
                            <TextBlock Text="{loc:Loc SdReset.Mode.FormatMain.Hint}" Style="{StaticResource HintText}"
                                       Margin="20,4,0,12" TextWrapping="Wrap" />
                            <RadioButton x:Name="ModeFormatEmu" GroupName="Mode"
                                         Content="{loc:Loc SdReset.Mode.FormatEmu}"
                                         Checked="Options_Changed" />
                            <TextBlock Text="{loc:Loc SdReset.Mode.FormatEmu.Hint}" Style="{StaticResource HintText}"
                                       Margin="20,4,0,12" TextWrapping="Wrap" />
                            <RadioButton x:Name="ModeCreateFiles" GroupName="Mode"
                                         Content="{loc:Loc SdReset.Mode.CreateEmuFiles}"
                                         Checked="Options_Changed" />
                            <TextBlock Text="{loc:Loc SdReset.Mode.CreateEmuFiles.Hint}" Style="{StaticResource HintText}"
                                       Margin="20,4,0,12" TextWrapping="Wrap" />
                            <RadioButton x:Name="ModeRepartition" GroupName="Mode"
                                         Content="{loc:Loc SdReset.Mode.Repartition}"
                                         Checked="Options_Changed" />
                            <TextBlock Text="{loc:Loc SdReset.Mode.Repartition.Hint}" Style="{StaticResource HintText}"
                                       Margin="20,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SdReset.FileSystem}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FileSystemPicker" SelectedIndex="0" Width="240" HorizontalAlignment="Left"
                                      MinHeight="34" VerticalContentAlignment="Center"
                                      SelectionChanged="Options_Changed">
                                <ComboBoxItem Content="{loc:Loc SdReset.FileSystem.Fat32}" />
                                <ComboBoxItem Content="{loc:Loc SdReset.FileSystem.ExFat}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- ══ 布局：拖动分隔条分配容量（取代原来的「emuMMC 大小」下拉框）══ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SdReset.Layout.Title}" Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold" Margin="0,0,0,10" />

                            <Border x:Name="LayoutBarHost" Height="34" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource ProgressTrackBrush}"
                                    Visibility="Collapsed">
                                <Canvas x:Name="LayoutCanvas" Background="Transparent">
                                    <Rectangle x:Name="MainBlock" Height="34" Width="0" Fill="{DynamicResource AccentBrush}" />
                                    <Rectangle x:Name="EmuBlock" Height="34" Width="0" Fill="#FF8A94A6" />

                                    <!-- 拖动用 Thumb：捕获与 DragDelta 都由它自己负责。
                                         手写 MouseDown/Move 的那版实测「方块不动」—— 命中、捕获、坐标换算全在我们自己手里，
                                         任何一环没接上就完全没有反应，也没有异常可查。 -->
                                    <Thumb x:Name="DragThumb" Width="18" Height="34" Cursor="SizeWE"
                                           DragDelta="DragThumb_DragDelta">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Rectangle Width="4" Height="34" Fill="#FFFFFFFF"
                                                               HorizontalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Canvas>
                            </Border>

                            <TextBlock x:Name="LayoutPlaceholder" Text="{loc:Loc SdReset.Layout.Empty}"
                                       Style="{StaticResource HintText}" />

                            <Grid x:Name="LegendPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{loc:Loc SdReset.Layout.Main}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- 容量可以**直接输入**（用户 2026-11-20 要求）：改一个，另一个跟着变。
                                     只在回车 / 离开输入框时提交，边打字边换算会把「12」打到一半就当成 1。 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="MainSizeBox"
                                             Width="92"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             KeyDown="SizeBox_KeyDown"
                                             LostFocus="MainSizeBox_LostFocus" />
                                    <TextBlock Text="{loc:Loc SdReset.Layout.Unit}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="LegendPanelEmu" Margin="0,6,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                               Fill="#FF8A94A6" />
                                    <TextBlock Text="{loc:Loc SdReset.Layout.Emu}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="EmuSizeBox"
                                             Width="92"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             KeyDown="SizeBox_KeyDown"
                                             LostFocus="EmuSizeBox_LostFocus" />
                                    <TextBlock Text="{loc:Loc SdReset.Layout.Unit}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="DragHint" Text="{loc:Loc SdReset.Layout.DragHint}"
                                       Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap" />

                            <TextBlock x:Name="RangeHint" Style="{StaticResource HintText}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- ══ 组件包下载 / 解压进度（用户 2026-11-21 要求）══
                         只在「准备」阶段出现；两条进度条分别对应下载与解压，
                         因为它们来源不同、卡住的排查方式也不同（网络 vs 磁盘/校验）。 -->
                    <Border x:Name="EmuPreparePanel" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SdReset.Prepare.EmuTitle}" Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="EmuDownloadLabel" Style="{StaticResource HintText}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="EmuDownloadBar" Height="6" Margin="0,4,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Style="{StaticResource FlatProgressBar}" />

                            <TextBlock x:Name="EmuExtractLabel" Style="{StaticResource HintText}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="EmuExtractBar" Height="6" Margin="0,4,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Style="{StaticResource FlatProgressBar}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ ② 准备与确认 ══ -->
                <Border x:Name="ConfirmPanel" Style="{StaticResource Card}" Padding="18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" Text="{loc:Loc SdReset.Confirm.Title}"
                                   Style="{StaticResource TitleText}" FontSize="17" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfirmDevice" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" Margin="0,14,0,10" />
                        <TextBlock x:Name="ConfirmLayout" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" />
                        <!-- 警告与「知晓」文案都按**当前做法**换（用户 2026-11-21）：
                             三种不动分区表的手术绝不提「清空整张卡」—— 那句话会让用户以为
                             自己选了会毁掉整卡的操作，于是不敢点下一步。 -->
                        <TextBlock x:Name="ConfirmWarning" Text="{loc:Loc SdReset.Confirm.Warning}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="Acknowledgement" Content="{loc:Loc SdReset.Confirm.Ack}"
                                  Margin="0,18,0,0"
                                  Checked="Acknowledgement_Changed" Unchecked="Acknowledgement_Changed" />
                    </StackPanel>
                </Border>

                <!-- ══ ③ 写入 / ④ 完成 ══ -->
                <Border x:Name="ResultPanel" Style="{StaticResource Card}" Padding="18" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource TitleText}" FontSize="18" />
                        <Grid Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="ResetProgress" Style="{StaticResource FlatProgressBar}"
                                         Height="8" IsIndeterminate="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProgressPercent" Grid.Column="1" Margin="12,0,0,0"
                                       MinWidth="40" TextAlignment="Right" Style="{StaticResource BodyText}" />
                        </Grid>
                        <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProgressPath" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                        <TextBlock x:Name="DownloadText" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                        <TextBlock x:Name="ResultHelp" Style="{StaticResource HintText}" Margin="0,14,0,0" />

                        <Border x:Name="CompletionPanel" Background="{DynamicResource InnerPanelBackgroundBrush}"
                                CornerRadius="8" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="CompletionAction" Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" LineHeight="24" />
                                <StackPanel x:Name="RebuildInstructions" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc SdReset.Done.Rebuild1}" Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" LineHeight="22" />
                                    <TextBlock Text="{loc:Loc SdReset.Done.Rebuild2}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ 底部按钮 ══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <!-- 确认页的主按钮在勾选「我已知晓」之前是禁用的。不写这句话，
                 用户看到的就是「按钮灰着、点了没反应」—— 这正是「没任何反应」的来源。 -->
            <TextBlock x:Name="AckHint" Text="{loc:Loc SdReset.Confirm.NeedAck}"
                       Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Margin="0,0,12,0" Visibility="Collapsed" />
            <Button x:Name="BackButton" Content="{loc:Loc SdReset.Button.Back}"
                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Back_Click" />
            <Button x:Name="CloseButton" Content="{loc:Loc SdReset.Button.Close}"
                    Style="{StaticResource SecondaryButton}" Click="Close_Click" />
            <Button x:Name="EjectResetButton" Content="{loc:Loc SdReset.Button.Eject}"
                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Eject_Click" />
            <Button x:Name="StartButton" Content="{loc:Loc SdReset.Button.Next}"
                    Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!--
      可空性警告**不许退化成普通警告**（2026-11-20）。
      移植层（SdReset/）攒过 30 处 CS8600/CS8604 —— 全是「可能为 null 的值塞进非空变量/参数」，
      运行时就是 NullReferenceException 的候选；而构建一直是绿的，只在日志里留一行 warning。
      清零之后把它们升级为错误：下次谁写错第一步就被拦住，而不是等它在写盘流程里炸。
      ⚠️ 只升级 nullable 这一组：NuGet / SDK 弃用等其它警告仍按默认策略，
         免得一次 SDK 升级把整个构建拦死。
    -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>SwitchCfwWizard</RootNamespace>
    <AssemblyName>SwitchCfwWizard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Switch CFW Wizard</AssemblyTitle>
    <Product>Switch CFW Wizard</Product>
    <Version>0.2.1</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <DebugType>embedded</DebugType>
    <!--
      程序图标：仓库根目录的 ico.ico（用户指定），exe 与任务栏/窗口共用同一份。
      ⚠️ 只有这一处路径会被 MSBuild 求值；XAML 那边走下面的 <Resource Link>，
      两处**指向同一个文件**，改图标只需换掉那个 ico。
    -->
    <ApplicationIcon>..\..\ico.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SharpCompress —— 唯一一个第三方依赖，只为解 usb-botbase 的 atmosphere.7z。

      .NET 8 自带的 System.IO.Compression 只认 zip，而 usb-botbase（Koi-3088）**只发 7z**，
      没有 zip 变体；本机也没有 7z 命令行可借。要么引这个包，要么这个插件只能让用户手动解压 ——
      用户 2026-09-18 选择了引入。

      ⚠️ 它的用途**仅限 7z**：zip 仍走自带的 ZipFile（见 ZipExtractor），
      别顺手把 zip 也换成 SharpCompress —— 那会把「零依赖」这条约定的代价白白放大。
    -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      多语言资源以嵌入式 JSON 形式打包；运行期可被 exe 同级 lang/ 目录下的同名文件覆盖。
      WithCulture=false 是必须的：否则 MSBuild 会把 Strings.zh-Hans.json 当成
      “zh-Hans 区域性资源”编译进卫星程序集，主程序集里就再也读不到它们了。
    -->
    <EmbeddedResource Include="Localization\Strings.*.json" WithCulture="false" />
  </ItemGroup>

  <!--
    ⚠️ boot.dat（SX GEAR 的引导文件）**刻意不在这里内嵌**。
    2026-09-21 起它改为按「高级设置 → boot.dat 下载地址」现场下载（见 Services/BootDatSource.cs），
    生成时只是把下好的那一份复制到 out/ 根目录。
    把资源条目加回去**不会报错**，但会让「下载失败 ⇒ 这一项跳过」的语义悄悄失效
    —— 那种「以为还有内置兜底」的怀疑最费时间，所以这里留一句说明。
  -->

  <ItemGroup>
    <!--
      上面 <ApplicationIcon> 只影响 exe 的文件图标；窗口标题栏/任务栏那一枚要走 WPF 资源，
      所以同一个 ico 再以 <Resource> 收一次，用 Link 放进程序集资源根（XAML 里 Icon="/ico.ico"）。
    -->
    <Resource Include="..\..\ico.ico" Link="ico.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      只为了让离线回归测试能验证「界面状态 → WizardOptions」这一步装配（BuildWizardOptions）。
      这一步走 private 成员，用公共 API 只能经 RunAsync 触发，而 RunAsync 必须联网下载。
      没有这个接缝就只能靠肉眼读那十几行赋值 —— 而「emuMMC 被赋成了 sysMMC 的值」这种
      复制粘贴错误恰恰是肉眼最容易漏、后果又最静默的（用户以为没屏蔽，配置却写进去了）。
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ConfigSmokeTest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!--
      「格式化与重建虚拟系统」用的原生组件（fatfs 格式化核心，x64，导出 ns_format）。
      ⚠️ 它同时以 **Content + EmbeddedResource** 两种方式收进来：
        · Content → 普通构建/多文件发布时就在 exe 旁边，直接 NativeLibrary.Load；
        · 内嵌副本 → **单文件发布时目录里只有 exe**，运行期释放到临时目录再加载
          （见 SdReset/NativeFormatter.cs）。只做一半的话，单文件版会在点「下一步」时
          报「找不到 NsToolbox.Formatter.dll」—— 而且编译、发布都不报错。
    -->
    <!--
      ⚠️ Content 那份要带 Condition：**单文件发布时不能复制**。
         否则单文件产物旁边会多出这个 dll，`build.sh` 的形态体检（根目录必须恰好 1 个文件）直接失败 ——
         而失败信息看着像「参数写错了」，其实只是多了一个随行文件。
         单文件场景由内嵌副本释放到临时目录（见 SdReset/NativeFormatter.cs）。
    -->
    <!--
      ⚠️ `Link` 不能省：Content 默认**保留源相对路径**，dll 会落到 `out/SdReset/Native/` 而不是 exe 旁边。
         NativeFormatter 只认 exe 同级，于是永远走「内嵌释放到临时目录」那条兜底 —— 程序照样能跑、
         自检照样全绿，但产物里多出一层没人用的目录，而「随程序发布的原生组件」实际上没被用上。
    -->
    <Content Include="SdReset\Native\NsToolbox.Formatter.dll"
             Link="NsToolbox.Formatter.dll"
             CopyToOutputDirectory="PreserveNewest"
             Condition="'$(PublishSingleFile)' != 'true'" />
    <EmbeddedResource Include="SdReset\Native\NsToolbox.Formatter.dll" LogicalName="SwitchCfwWizard.Native.NsToolbox.Formatter.dll" />

    <!--
        配置模板（2026-11-21）：**编进程序**，不往 exe 旁边放文件（用户明确要求「不单独放出」）。
        资源名固定成 SwitchCfwWizard.Templates.<id>.json —— 中文文件名当资源名在不同机器/打包路径下
        容易出现编码与转义差异，界面上的显示名由语言包给（Template.Play / Template.Study）。
        用户自己导入的模板仍然落到 exe 同级的 templates/ 目录（导入这个动作本身就要写盘）。
    -->
    <EmbeddedResource Include="Templates\play.json" LogicalName="SwitchCfwWizard.Templates.play.json" />
    <EmbeddedResource Include="Templates\study.json" LogicalName="SwitchCfwWizard.Templates.study.json" />

    <!--
        「自动创建 emuMMC」的 hekate 自动化载荷（NsToolbox.AutoEmu.zip，2.7 MB）自 2026-11-21 起
        **不再内嵌**：用户要求删掉这份旧资源，改由「格式化并重建 emuMMC」从
        https://github.com/q1378659137/AutoEmu/releases 下载最新版，落到 download/AutoEmu_<版本>.zip；
        离线场景用主界面的「优先使用本地资源」复用那份已下载的 zip。
    -->
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本项目不依赖任何第三方 NuGet 包，仅使用 .NET 8 自带类库（WPF / BCL）。
    保留此文件是为了让还原行为显式、可复现。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

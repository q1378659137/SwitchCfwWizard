<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本项目只依赖**一个**第三方 NuGet 包：SharpCompress（见 SwitchCfwWizard.csproj 里的注释 ——
    只为解 usb-botbase 的 atmosphere.7z，.NET 8 自带类库不支持 7z）。
    其余一律使用 .NET 8 自带类库（WPF / BCL）。
    保留此文件是为了让还原行为显式、可复现。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
